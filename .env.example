# 域名必须已解析到 VPS；JIYU_ORIGIN 需要与浏览器访问地址完全一致。
JIYU_DOMAIN=files.example.com
JIYU_ORIGIN=https://files.example.com
JIYU_QUOTA_MB=10240
JIYU_REQUEST_MB=512
JIYU_DATA_SUBDIR=live
# 可选：限制在线自动备份最多保留份数（1–30，默认 30）。
JIYU_BACKUP_MAX_KEEP=30
# 可选：预置模型，用户免配置即可使用 AI。BASE_URL / MODEL / KEY 三项都填才生效；Key 只留在这个文件和进程环境里。
JIYU_AI_BASE_URL=
JIYU_AI_MODEL=
JIYU_AI_KEY=
# 可选：预置模型接口协议（chat 或 responses，默认 chat）。
JIYU_AI_PROTOCOL=chat
# 可选：预置推理模型的思考强度（minimal / low / medium / high，留空则不传该字段）。
JIYU_AI_REASONING_EFFORT=
JIYU_AI_DAILY_CALLS=50
# 可选：公开体验模式（仅当显式开启且存在对应 editor 成员账号时，登录页显示一键访客体验入口）。
JIYU_DEMO_ENABLED=false
JIYU_DEMO_USERNAME=demo
JIYU_RATE_LIMIT_DEMO=10
# 可选：限流阈值覆盖（默认：全局 180 次/分、multipart 上传 30 次/时、分片批次创建 60 次/时、分片上传 180 次/分、提取码解锁 6 次/分）。
JIYU_RATE_LIMIT_GLOBAL=180
JIYU_RATE_LIMIT_UPLOAD_MULTIPART=30
JIYU_RATE_LIMIT_UPLOAD_CREATE=60
JIYU_RATE_LIMIT_UPLOAD_CHUNK=180
JIYU_RATE_LIMIT_UNLOCK=6
# 可选：远端存储严格读回校验（设为 1 时强制重新下载校验 SHA-256，留空则优先校验云端摘要）。
JIYU_STORAGE_STRICT_READBACK=
# 可选：任务定时截止预警巡检间隔（秒，10–86400，默认 300）。
JIYU_DEADLINE_CHECK_INTERVAL_SECONDS=300
